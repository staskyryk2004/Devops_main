INSTANCE1_NAME=nginx-port80
INSTANCE1_PORT=80
INSTANCE1_CONF_DIR=/etc/nginx-port80
INSTANCE1_ACCESS_LOG=/var/log/nginx/port80-access.log
INSTANCE1_ERROR_LOG=/var/log/nginx/port80-error.log
INSTANCE1_PID=/run/nginx-port80.pid
INSTANCE1_MESSAGE="Handled by Nginx Port 80"

INSTANCE2_NAME=nginx-port8080
INSTANCE2_PORT=8080
INSTANCE2_CONF_DIR=/etc/nginx-port8080
INSTANCE2_ACCESS_LOG=/var/log/nginx/port8080-access.log
INSTANCE2_ERROR_LOG=/var/log/nginx/port8080-error.log
INSTANCE2_PID=/run/nginx-port8080.pid
INSTANCE2_MESSAGE="Handled by Nginx Port 8080"
