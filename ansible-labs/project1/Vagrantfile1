Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"

  # ==========================================
  # NODE A: Nginx Proxy
  # ==========================================
  config.vm.define "node_a" do |a|
    a.vm.hostname = "node-a"
    a.vm.network "private_network", ip: "172.16.0.10"
    a.vm.network "private_network", ip: "192.168.100.10"
  end

  # ==========================================
  # NODE B: MySQL Database (Без Інтернету)
  # ==========================================
  config.vm.define "node_b" do |b|
    b.vm.hostname = "node-b"
    b.vm.network "private_network", ip: "192.168.101.20"
    
    # Вимикаємо стандартний Gateway за замовчуванням, щоб перекрити доступ до Інтернету
    b.vm.provision "shell", run: "always", inline: <<-'SHELL'
      sudo ip route del default dev eth0 || true
    SHELL
  end

  # ==========================================
  # NODE C: Apache + WordPress
  # ==========================================
  config.vm.define "node_c" do |c|
    c.vm.hostname = "node-c"
    c.vm.network "private_network", ip: "192.168.100.30"
    c.vm.network "private_network", ip: "192.168.101.30"
    c.vm.network "private_network", ip: "192.168.102.30"
  end

  # ==========================================
  # Provisioner: Ansible
  # ==========================================
  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "playbook.yml"
    ansible.groups = {
      "proxy" => ["node_a"],
      "db"    => ["node_b"],
      "web"   => ["node_c"]
    }
  end
end