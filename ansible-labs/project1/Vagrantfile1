Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  # Збільшуємо таймаут чекання SSH до 20 хвилин
  config.vm.boot_timeout = 1200 

  config.vm.provider :libvirt do |lv|
    lv.driver = "qemu"
    lv.graphics_type = "none" # Вимикаємо графіку, це суттєво прискорює boot
    lv.cpus = 2
    lv.memory = 1024
  end

  # Node B: Database
  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "192.168.101.20"
  end

  # Node C: Web Server
  config.vm.define "web" do |web|
    web.vm.hostname = "web"
    web.vm.network "private_network", ip: "192.168.101.30"
  end
end
