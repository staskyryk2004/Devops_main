Vagrant.configure("2") do |config|

  config.vm.boot_timeout = 600

  config.vm.provider :libvirt do |lv|
    lv.driver = "qemu"
    lv.memory = 1024
    lv.cpus = 2
    lv.graphics_type = "none"
  end

  config.vm.box = "generic/ubuntu2204"
  config.vm.box_check_update = false

  # ==========================================
  # VM-A: Nginx Reverse Proxy
  # ==========================================
  config.vm.define "vm-a" do |a|
    a.vm.hostname = "vm-a"
    a.vm.network "private_network", ip: "172.16.0.10"
    a.vm.network "private_network", ip: "192.168.100.10"

    a.vm.provision "shell", inline: <<-SHELL
      set -e
      # Вмикаємо IP Forwarding
      sudo sed -i 's/#net.ipv4.ip_forward=1/net.ipv4.ip_forward=1/g' /etc/sysctl.conf
      sudo sysctl -p

      sudo apt-get update && sudo apt-get install -y nginx

      # Конфігурація Nginx як Reverse Proxy до VM-C (WordPress)
      cat <<EOF | sudo tee /etc/nginx/sites-available/mysite.local
server {
    listen 80;
    server_name mysite.local;

    location / {
        proxy_pass http://192.168.102.30:80;
        proxy_set_header Host \\$host;
        proxy_set_header X-Real-IP \\$remote_addr;
        proxy_set_header X-Forwarded-For \\$proxy_add_x_forwarded_for;
    }
}
EOF
      sudo ln -sf /etc/nginx/sites-available/mysite.local /etc/nginx/sites-enabled/
      sudo rm -f /etc/nginx/sites-enabled/default
      sudo systemctl restart nginx
    SHELL
  end

  # ==========================================
  # VM-B: MySQL Server (База Даних)
  # ==========================================
  config.vm.define "vm-b" do |b|
    b.vm.hostname = "vm-b"
    b.vm.network "private_network", ip: "192.168.101.20"
    b.vm.network "private_network", ip: "192.168.100.20"

    b.vm.provision "shell", inline: <<-SHELL
      set -e
      sudo apt-get update && sudo apt-get install -y mysql-server

      # У Ubuntu 24.04 конфіг MySQL лежить у mysqld.cnf
      sudo sed -i 's/bind-address.*/bind-address = 0.0.0.0/g' /etc/mysql/mysql.conf.d/mysqld.cnf
      sudo systemctl restart mysql

      # Створення бази та користувача для WordPress
      sudo mysql -e "CREATE DATABASE IF NOT EXISTS wordpress DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
      sudo mysql -e "CREATE USER IF NOT EXISTS 'wp_user'@'%' IDENTIFIED BY 'password123';"
      sudo mysql -e "GRANT ALL PRIVILEGES ON wordpress.* TO 'wp_user'@'%';"
      sudo mysql -e "FLUSH PRIVILEGES;"
    SHELL

    # Відключаємо зовнішній Інтернет (NAT) для ізоляції бази
    b.vm.provision "shell", run: "always", inline: "sudo ip link set eth0 down || true"
  end

  # ==========================================
  # VM-C: Apache + PHP 8.3 + WordPress
  # ==========================================
  c_config = config.vm.define "vm-c" do |c|
    c.vm.hostname = "vm-c"
    c.vm.network "private_network", ip: "192.168.102.30"
    c.vm.network "private_network", ip: "192.168.100.30"
    c.vm.network "private_network", ip: "192.168.101.30"

    c.vm.provision "shell", inline: <<-SHELL
      set -e
      # Встановлюємо Apache та PHP (у Ubuntu 24.04 це PHP 8.3)
      sudo apt-get update && sudo apt-get install -y apache2 php libapache2-mod-php php-mysql wget unzip

      # Завантаження WordPress
      cd /tmp && wget -q https://wordpress.org/latest.tar.gz
      tar -xzf latest.tar.gz
      sudo mkdir -p /var/www/html/wordpress
      sudo cp -r wordpress/* /var/www/html/wordpress/
      sudo chown -R www-data:www-data /var/www/html/wordpress

      # Конфігурація wp-config.php з підключенням до VM-B (192.168.101.20)
      sudo cp /var/www/html/wordpress/wp-config-sample.php /var/www/html/wordpress/wp-config.php
      sudo sed -i "s/database_name_here/wordpress/" /var/www/html/wordpress/wp-config.php
      sudo sed -i "s/username_here/wp_user/" /var/www/html/wordpress/wp-config.php
      sudo sed -i "s/password_here/password123/" /var/www/html/wordpress/wp-config.php
      sudo sed -i "s/localhost/192.168.101.20/" /var/www/html/wordpress/wp-config.php

      # Конфігурація Apache VirtualHost
      cat <<EOF | sudo tee /etc/apache2/sites-available/wordpress.conf
<VirtualHost *:80>
    ServerName mysite.local
    DocumentRoot /var/www/html/wordpress
    <Directory /var/www/html/wordpress/>
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
EOF

      sudo a2ensite wordpress.conf
      sudo a2dissite 000-default.conf
      sudo systemctl restart apache2
    SHELL
  end
end
